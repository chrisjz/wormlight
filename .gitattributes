# Check out text with LF endings everywhere, so nothing a build hashes changes with the platform.
* text=auto eol=lf

# Pinned by SHA-256: stored and checked out byte for byte, never converted.
data/vendor/** -text
data/c302-cells.sha256 -text
data/sign-overrides.csv -text

# Goldens and the licence beside them are checked by digest: stored byte for byte, never diffed as text.
tests/fixtures/** -text
*.f32 binary
